// Copy this file to Config/Secrets.xcconfig and fill in what you need.
// Config/Secrets.xcconfig is git-ignored: never commit real keys.
//
// Two ways to configure FIX:
//
// 1. Relay (preferred, and the only option suitable for a shipped build).
//    Point the app at a backend you control that holds the provider keys and
//    forwards to Groq / YouTube. Host and optional path only, no scheme —
//    xcconfig treats "//" as the start of a comment.
//
//    FIX_RELAY_BASE_URL = fix-relay.example.com/v1
//
// 2. Direct provider access (development only — the key ships inside the app
//    binary and can be extracted from it).
//
//    FIX_GROQ_API_KEY = gsk_your_development_key
//    FIX_YOUTUBE_API_KEY = your_youtube_data_api_key
//
// Optional: pick a different Groq model.
//    FIX_GROQ_MODEL = llama-3.3-70b-versatile
//
// You can also set FIX_RELAY_BASE_URL / FIX_GROQ_API_KEY / FIX_YOUTUBE_API_KEY
// as environment variables on the Xcode scheme, which keeps them out of the
// build products entirely. Scheme values win over these.

FIX_RELAY_BASE_URL =
FIX_GROQ_API_KEY =
FIX_YOUTUBE_API_KEY =
